{
    "name": "@fedeghe/testone",
    "version": "0.2.16",
    "description": "small testing utility",
    "scripts": {
        "dev": "malta source/builddev.json",
        "build": "malta source/build.json",
        "test": "jest",
        "cover": "jest --coverage"
    },
    "jest": {
        "testMatch": [
            "<rootDir>/tests/**/*.js"
        ]
    },
    "main": "dist/index.js",
    "repository": "https://github.com/fedeghe/testone.git",
    "keywords": [
        "test",
        "micro test",
        "micro benchmark",
        "micro benchmarking"
    ],
    "author": "fedeghe <fedeghe@gmail.com>",
    "license": "MIT",
    "devDependencies": {
        "jest": "^30.2.0",
        "malta": "^4.1.43",
        "malta-header-comment": "^1.0.12",
        "malta-jest": "^0.0.2",
        "malta-millijs": "^1.0.5"
    }
}
